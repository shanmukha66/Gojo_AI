# Local app database
APP_DB_PATH="./data/app.db"

# Neo4j connection
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"

# Text AI provider. Keep real keys only in web/.env.local or your secret manager.
AI_PROVIDER="minimax"
MINIMAX_API_KEY="your_minimax_token_plan_key_here"
MINIMAX_MODEL="MiniMax-M2.7"
MINIMAX_LIGHT_MODEL="MiniMax-M2.7"
MINIMAX_REASONING_MODEL="MiniMax-M2.7"
MINIMAX_BASE_URL="https://api.minimax.io/v1/text/chatcompletion_v2"

# Optional vision-only provider for uploaded images. Leave empty if unused.
OPENAI_TEXT_FALLBACK="false"
OPENAI_API_KEY="your_openai_key_here"
OPENAI_VISION_MODEL="gpt-4.1-nano"
OPENAI_VISION_DAILY_LIMIT="25"
OPENAI_VISION_MAX_IMAGE_MB="4"

# Cost/cache controls
AI_CACHE_TTL_SECONDS="86400"
AI_DAILY_TOKEN_SOFT_LIMIT="80000"
